configure-ollama.sh
fix-docker.sh

# WeChat Mini Program local/private configuration
miniprogram/project.private.config.json

# Staging dir for the Docker sandbox self-check probe (removed after each run)
.weknora-sandbox-check-*

# Locally built BrowserSkill runtime and extension bundles
/artifacts/browserskill/

# UI 升级取证引导页（含本地登录 token，永不提交）
frontend/public/__ui_lab_bootstrap.html
