# 模型配置建议（基于你的当前配置）
#
# 使用方法：
# 1. 复制下面的配置到 .env 文件中
# 2. 重启服务使配置生效
# 3. 验证模型是否正常加载

# ========== 你当前的配置 ==========

# LLM 对话模型（已配置 ✅）
LLM_MODEL_NAME=qwen3.7-plus
LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
LLM_API_KEY=sk-sp-60f4f99e70c64ea694a28cf702c93dc1
LLM_PROVIDER=anthropic

# ========== 需要补充的配置 ==========

# Embedding 向量模型（必须配置 ⚠️）
# 用于将文档向量化，是 RAG 系统的核心组件
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-sp-60f4f99e70c64ea694a28cf702c93dc1
EMBEDDING_PROVIDER=openai

# Rerank 重排序模型（强烈推荐 ⚠️）
# 用于重排序检索结果，显著提升 RAG 精度
RERANK_MODEL_NAME=gte-rerank
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=sk-sp-60f4f99e70c64ea694a28cf702c93dc1
RERANK_PROVIDER=openai

# ========== 可选配置 ==========

# 备用 LLM 模型（可选）
# 如果需要备用模型，可以通过 Web UI 添加，或在 builtin_models.yaml 中配置

# VLM 视觉语言模型（可选）
# 如果需要图片理解功能，可以配置
# VLM_MODEL_NAME=qwen-vl-plus
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_API_KEY=sk-sp-60f4f99e70c64ea694a28cf702c93dc1
# VLM_PROVIDER=openai

# ASR 语音识别模型（可选）
# 如果需要语音转文字功能，可以配置
# ASR_MODEL_NAME=paraformer-realtime-v2
# ASR_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASR_API_KEY=sk-sp-60f4f99e70c64ea694a28cf702c93dc1
# ASR_PROVIDER=openai

# ========== 说明 ==========

# 1. 所有模型都使用阿里云百炼平台，可以用同一个 API Key
# 2. text-embedding-v3 是多语言模型，支持中英文
# 3. gte-rerank 显著提升检索精度，强烈建议配置
# 4. 配置完成后，重启服务并在 Web UI 中确认模型已加载

# ========== 成本估算 ==========

# 假设每天 1000 次问答，100 个文档：
# - LLM (qwen3.7-plus): ~¥600/月
# - Embedding (text-embedding-v3): ~¥10/月
# - Rerank (gte-rerank): ~¥21/月
# 总计：~¥631/月

# ========== 获取 API Key ==========

# 阿里云百炼：https://dashscope.console.aliyun.com/
# 1. 注册/登录阿里云账号
# 2. 开通百炼服务
# 3. 创建 API Key
# 4. 将 API Key 填入上面的配置中
